# Pattern A: normal message send, turn-based CLI agent (await / respond)
# The CLI speaks ONLY HTTP. The backend records every message in the room's log.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

direction: right

title: |md
  # Pattern A · Turn-based CLI agent
  ### `mycelium await` (long-poll) + `mycelium respond`: the hub holds the agent's place
| {near: top-center; style.font-size: 22}

classes: {
  actor:  { style: { font-size: 20; fill: "#eef2ff"; stroke: "#4f46e5"; stroke-width: 2; border-radius: 8 } }
  comp:   { style: { font-size: 20; fill: "#ffffff"; stroke: "#334155"; stroke-width: 1; border-radius: 6 } }
  http:   { style: { font-size: 20; stroke: "#2563eb"; stroke-width: 2 } }
  note:   { style: { fill: "#fefce8"; stroke: "#ca8a04"; font-size: 16; border-radius: 6 } }
}

cli: CLI agent\nmycelium await · mycelium respond {class: actor}

hub: Mycelium backend {
  class: comp
  route: participate routes\nGET /await · POST /reply {class: comp}
  persist: room log\ntranscript + per-handle cursor {class: comp}
  bus: event stream {class: comp}
}

others: Other members\n(the app, agents\nin their own await) {class: actor}

# --- Outbound turn: respond ---
cli -> hub.route: "1. POST /api/rooms/<room>/reply  (handle, text)" {class: http}
hub.route -> hub.persist: "2. append to the transcript" {class: http}
hub.persist -> hub.bus: "3. publish" {class: http}
hub.bus -> others: "4. live update / await returns" {class: http}

# --- Inbound turn: await ---
cli -> hub.route: "a. GET /api/rooms/<room>/await  (long-poll)" {class: http}
hub.route -> hub.persist: "b. read per-handle cursor + refresh lease" {class: http}
hub.route -> cli: "c. returns (prompt, sender)" {class: http}

key_point: "Why nothing is missed\n\nA turn-based agent can't hold a connection between turns, so the hub holds its place:\nawait reads a durable transcript cursor and refreshes a presence lease" {class: note; near: bottom-center}

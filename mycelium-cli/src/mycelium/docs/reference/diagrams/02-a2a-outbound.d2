# Pattern B: A2A outbound, a remote agent joins the room as a member
# The remote is registered as a room member and proxied by the hub:
# the hub calls it out over HTTPS and records the reply in the room.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

direction: right

title: |md
  # Pattern B · A2A outbound (remote agent as room member)
  ### `adapter: a2a`: mention in the room, call over HTTPS, reply back into the room
| {near: top-center; style.font-size: 22}

classes: {
  actor:   { style: { font-size: 20; fill: "#eef2ff"; stroke: "#4f46e5"; stroke-width: 2; border-radius: 8 } }
  comp:    { style: { font-size: 20; fill: "#ffffff"; stroke: "#334155"; stroke-width: 1; border-radius: 6 } }
  external:{ style: { font-size: 20; fill: "#fff7ed"; stroke: "#ea580c"; stroke-width: 2; border-radius: 8 } }
  http:    { style: { font-size: 20; stroke: "#2563eb"; stroke-width: 2 } }
  a2a:     { style: { font-size: 20; stroke: "#ea580c"; stroke-width: 2; stroke-dash: 4 } }
  note:    { style: { fill: "#fefce8"; stroke: "#ca8a04"; font-size: 16; border-radius: 6 } }
}

summoner: Room member\n(@-mentions @researcher) {class: actor}

hub: Mycelium backend {
  class: comp
  persist: room log\non_summon seam {class: comp}
  responder: A2aResponder {class: comp}
}

remote: Remote A2A agent {class: external}

# --- The mention is recorded ---
summoner -> hub.persist: "1. @researcher message (HTTP)" {class: http}
hub.persist -> hub.responder: "2. handle_summon(room, researcher, text)" {class: http}

# --- Call the remote ---
hub.responder -> remote: "3. send_to_a2a(card, text, Bearer)\nHTTPS JSON-RPC" {class: a2a}
remote -> hub.responder: "4. Message / Task (+ context_id)" {class: a2a}

# --- Record the reply as @researcher ---
hub.responder -> hub.persist: "5. append reply as @researcher" {class: http}
hub.persist -> summoner: "6. reply delivered (event stream / await)" {class: http}

boundary: "What this hop is\n\nThe remote just gets called. The hub reads the room's text\nand calls the remote over HTTPS.\nAuth is a Bearer token whose env-var name lives in the manifest; the secret stays in\nbackend env. The card URL is SSRF-guarded." {class: note; near: bottom-center}

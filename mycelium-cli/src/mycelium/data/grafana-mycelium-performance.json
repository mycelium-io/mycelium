{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "mycelium-performance"
  },
  "spec": {
    "title": "Mycelium Performance",
    "editable": true,
    "liveNow": false,
    "preload": false,
    "tags": [
      "mycelium"
    ],
    "timeSettings": {
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "1h"
      ],
      "fiscalYearStartMonth": 0,
      "hideTimepicker": false,
      "timezone": "browser"
    },
    "cursorSync": "Off",
    "links": [],
    "variables": [],
    "annotations": [],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "HTTP request rate (req/s)",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "query": {
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(rate(http_server_duration_milliseconds_count[1m])) by (http_route)",
                        "legendFormat": "{{http_route}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.2.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 1,
                    "fillOpacity": 5,
                    "showPoints": "auto",
                    "spanNulls": false
                  }
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "HTTP p95 latency (ms)",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "query": {
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[2m])) by (le, http_route))",
                        "legendFormat": "{{http_route}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.2.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 1,
                    "fillOpacity": 5,
                    "showPoints": "auto",
                    "spanNulls": false
                  },
                  "unit": "ms"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "HTTP 5xx error rate",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "query": {
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(rate(http_server_duration_milliseconds_count{http_response_status_code=~\"5..\"}[2m])) by (http_route)",
                        "legendFormat": "{{http_route}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.2.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 1,
                    "fillOpacity": 5,
                    "showPoints": "auto",
                    "spanNulls": false
                  }
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Aligner convergence rate",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "query": {
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(increase(mycelium_aligner_run_duration_milliseconds_count{mycelium_aligner_outcome=\"converged\"}[1h])) / sum(increase(mycelium_aligner_run_duration_milliseconds_count[1h]))",
                        "legendFormat": "converged / total"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "version": "13.2.0",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 1,
                    "fillOpacity": 5,
                    "showPoints": "auto",
                    "spanNulls": false
                  }
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            }
          },
          "description": "1.0 = all runs converged"
        }
      },

# Unified Mycelium "spoke" device image.
#
# Bundles the three adapter runtimes so a single container can stand in
# for any combination of openclaw / cursor / hermes agents in compose-based
# E2E runs. Which subset actually starts at runtime is controlled by the
# ``SPOKE_ADAPTERS`` env var (comma-separated, default "openclaw").
#
# Published to ghcr.io/mycelium-io/mycelium-spoke:latest by the
# build-spoke workflow. For source/CI builds, use the ``spoke-dev`` target
# after copying a mycelium_cli wheel to ``infra/mycelium_cli.whl``.
#
# Process supervision is intentionally NOT systemd:
#  - PID 1 is ``tini`` (reaps zombies, forwards signals).
#  - tini execs the entrypoint script.
#  - The entrypoint generates a per-run ``supervisord.conf`` populated
#    only with the processes the requested adapters need, then exec's
#    supervisord to run them all in the foreground.
#
# Usage:
#   # Release (GHCR) — CLI installed at runtime by spoke-entrypoint.sh
#   docker build -f infra/Dockerfile.spoke --target spoke .
#
#   # CI / lab — bake a source-branch CLI wheel into the image
#   cp mycelium_cli-*.whl infra/mycelium_cli.whl
#   docker build -f infra/Dockerfile.spoke --target spoke-dev .

FROM node:22-bookworm-slim AS spoke-base

# ── System deps ──────────────────────────────────────────────────────
#
# - python3 / pip: hermes-agent + optional baked mycelium CLI wheel
# - git: hermes-agent ships some skills as git checkouts
# - curl/wget/jq: bootstrap + healthchecks
# - procps: pgrep/pkill for hermes gateway restart in supervisord containers
# - tini + supervisor: PID 1 + multi-process orchestration (no systemd)
# - gosu: privilege drop in entrypoint
# - libsecret-1-0, libnss3: cursor-agent headless keyring stubs

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash curl wget jq ca-certificates git tini supervisor gosu procps \
        python3 python3-pip python3-venv \
        ripgrep ffmpeg \
        libsecret-1-0 libnss3 \
    && rm -rf /var/lib/apt/lists/*

# ── OpenClaw gateway (Node) ──────────────────────────────────────────

RUN npm install -g openclaw@latest \
    && npm cache clean --force \
    && rm -rf /tmp/* /root/.npm

# ── Cursor agent (glibc) ─────────────────────────────────────────────
#
# The official installer drops files under /root/.local, which the ``spoke``
# user cannot read. Copy the versioned bundle to /usr/local/share and symlink
# /usr/local/bin/cursor-agent so every UID on PATH can invoke it.

ARG CURSOR_AGENT_VERSION="latest"
RUN curl -fsSL https://cursor.com/install | \
        CURSOR_INSTALL_VERSION="${CURSOR_AGENT_VERSION}" bash && \
    CUR_VER="$(ls /root/.local/share/cursor-agent/versions | head -1)" && \
    mkdir -p "/usr/local/share/cursor-agent/versions/${CUR_VER}" && \
    cp -a "/root/.local/share/cursor-agent/versions/${CUR_VER}/." \
          "/usr/local/share/cursor-agent/versions/${CUR_VER}/" && \
    ln -sf "/usr/local/share/cursor-agent/versions/${CUR_VER}/cursor-agent" \
          /usr/local/bin/cursor-agent && \
    chmod -R a+rX /usr/local/share/cursor-agent && \
    cursor-agent --version

# ── Hermes agent (Python) ────────────────────────────────────────────

ARG HERMES_AGENT_VERSION=""
RUN if [ -n "${HERMES_AGENT_VERSION}" ]; then \
        pip3 install --no-cache-dir --break-system-packages \
            "hermes-agent==${HERMES_AGENT_VERSION}"; \
    else \
        pip3 install --no-cache-dir --break-system-packages hermes-agent || \
            echo "[Dockerfile.spoke] hermes-agent install skipped (offline build)"; \
    fi
# mycelium-room hermes plugin uses aiohttp for SSE + outbound POST; hermes-agent
# does not pull it in as a base dependency.
RUN pip3 install --no-cache-dir --break-system-packages aiohttp || \
    echo "[Dockerfile.spoke] aiohttp install skipped (offline build)"

# ── Filesystem layout ────────────────────────────────────────────────

RUN mkdir -p /openclaw /shared /etc/supervisor/conf.d \
    && useradd --create-home --home-dir /home/spoke --shell /bin/bash --uid 1001 spoke \
    && chown -R spoke:spoke /openclaw /shared /home/spoke

COPY --chown=spoke:spoke infra/scripts/spoke-entrypoint.sh /openclaw/entrypoint.sh
COPY --chown=spoke:spoke infra/scripts/install-openclaw-skills.sh /openclaw/install-openclaw-skills.sh
COPY --chown=spoke:spoke infra/scripts/patch-hermes-plugin.sh /openclaw/patch-hermes-plugin.sh
COPY --chown=spoke:spoke infra/scripts/daemon-subscribe.sh /openclaw/daemon-subscribe.sh
COPY --chown=spoke:spoke infra/scripts/patch-mycelium-daemon.sh /openclaw/patch-mycelium-daemon.sh
COPY --chown=spoke:spoke infra/scripts/install-openclaw-mycelium-plugin.sh /openclaw/install-openclaw-mycelium-plugin.sh
COPY --chown=spoke:spoke infra/scripts/patch-openclaw-plugin.sh /openclaw/patch-openclaw-plugin.sh
COPY --chown=spoke:spoke infra/scripts/restart-hermes-gateway.sh /openclaw/restart-hermes-gateway.sh
COPY --chown=spoke:spoke infra/scripts/restart-openclaw-gateway.sh /openclaw/restart-openclaw-gateway.sh
RUN chmod +x /openclaw/entrypoint.sh /openclaw/install-openclaw-skills.sh \
    /openclaw/daemon-subscribe.sh /openclaw/patch-mycelium-daemon.sh \
    /openclaw/install-openclaw-mycelium-plugin.sh \
    /openclaw/patch-hermes-plugin.sh /openclaw/patch-openclaw-plugin.sh \
    /openclaw/restart-hermes-gateway.sh /openclaw/restart-openclaw-gateway.sh

ENV OPENCLAW_ROLE=spoke1 \
    SPOKE_ADAPTERS=openclaw \
    MATRIX_HOMESERVER=http://matrix-synapse:8008 \
    MYCELIUM_BACKEND_URL=http://mycelium-backend:8000 \
    COLLECTOR_HUB_URL=http://mycelium-collector:4318 \
    MATRIX_SHARED_SECRET=e2e-shared-secret \
    TOKEN_FILE=/shared/matrix-tokens.json \
    HERMES_HOME=/home/spoke/.hermes \
    PATH="/usr/local/bin:${PATH}"

# ── Dev/CI target: bake a mycelium CLI wheel from the build context ──
#
# e2e.yml copies the wheel to infra/mycelium_cli.whl before building this
# target. Release builds use the ``spoke`` target instead and let the
# entrypoint install CLI from the release channel on first boot.

FROM spoke-base AS spoke-dev
COPY infra/mycelium_cli*.whl /tmp/
ENV UV_PYTHON_INSTALL_DIR=/usr/local/share/uv/python
RUN WHEEL="$(ls /tmp/mycelium_cli*.whl | head -1)" \
    && curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local sh \
    && /usr/local/uv python install 3.12 \
    && UV_TOOL_DIR=/usr/local/share/uv/tools /usr/local/uv tool install --python 3.12 \
         --force --from "$WHEEL" mycelium-cli \
    && chmod -R a+rX /usr/local/share/uv \
    && ln -sf /usr/local/share/uv/tools/mycelium-cli/bin/mycelium /usr/local/bin/mycelium \
    && rm -f /tmp/mycelium_cli*.whl \
    && mycelium --version \
    && bash /openclaw/patch-mycelium-daemon.sh

# ── Final runtime image ──────────────────────────────────────────────

FROM spoke-dev AS spoke
WORKDIR /openclaw
# Matrix plugin must land in spoke's ~/.openclaw (supervisord runs as spoke).
USER spoke
RUN openclaw plugins install @openclaw/matrix \
    && openclaw plugins enable matrix
USER root

ENTRYPOINT ["/usr/bin/tini", "--", "/openclaw/entrypoint.sh"]

# Release alias: pre-bakes the mycelium CLI from PyPI (no local wheel needed).
# build-openclaw.yml publishes this target to GHCR.
FROM spoke-base AS spoke-release
# Pass the mycelium CLI version to bake in, e.g.:
#   docker build --build-arg MYCELIUM_VERSION=$(gh api repos/mycelium-io/mycelium/releases/latest --jq .tag_name) ...
ARG MYCELIUM_VERSION
ENV UV_PYTHON_INSTALL_DIR=/usr/local/share/uv/python \
    UV_TOOL_DIR=/usr/local/share/uv/tools
RUN curl -fsSL https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && UV_INSTALL_DIR=/usr/local sh /tmp/uv-install.sh \
    && rm /tmp/uv-install.sh \
    && if [ -n "$MYCELIUM_VERSION" ]; then \
         MC_VER="${MYCELIUM_VERSION#v}"; \
       else \
         MC_VER=$(curl -fsSL https://api.github.com/repos/mycelium-io/mycelium/releases/latest | grep '"tag_name"' | head -1 | sed 's/.*"v\([^"]*\)".*/\1/'); \
       fi \
    && curl -fsSL \
        "https://github.com/mycelium-io/mycelium/releases/download/v${MC_VER}/mycelium_cli-${MC_VER}-py3-none-any.whl" \
        -o "/tmp/mycelium_cli-${MC_VER}-py3-none-any.whl" \
    && /usr/local/uv tool install "/tmp/mycelium_cli-${MC_VER}-py3-none-any.whl" --python 3.12 --force \
    && rm "/tmp/mycelium_cli-${MC_VER}-py3-none-any.whl" \
    && chmod -R a+rX /usr/local/share/uv \
    && ln -sf /usr/local/share/uv/tools/mycelium-cli/bin/mycelium /usr/local/bin/mycelium \
    && mycelium --version \
    && bash /openclaw/patch-mycelium-daemon.sh
WORKDIR /openclaw
USER spoke

RUN openclaw plugins install @openclaw/matrix \
    && openclaw plugins enable matrix

ENTRYPOINT ["/usr/bin/tini", "--", "/openclaw/entrypoint.sh"]

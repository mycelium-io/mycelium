# Builds the mycelium CLI from this commit's local mycelium-cli/ source
# (context: mycelium-cli — see compose.spokes.yaml) instead of installing
# a released wheel, so spokes always test the CLI at the commit under
# test. Requires scripts/gen-mycelium-client.sh to have already populated
# src/mycelium_backend_client/ on the host before this build runs.
FROM python:3.12-slim

RUN apt-get update -qq && apt-get install -qq -y curl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv

WORKDIR /build
COPY . .
RUN uv pip install --system --no-cache . && \
    pip uninstall -y uv

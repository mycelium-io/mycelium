<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the app itself needs under the hardened runtime (scripts/package-mac.sh
  signs the bundle with it). The programs inside it take programs.entitlements.
  - device.audio-input: the composer's mic. Without it macOS refuses the
    microphone outright rather than asking, whatever Info.plist says.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>

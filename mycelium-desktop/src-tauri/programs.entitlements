<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the programs inside the app need under the hardened runtime that
  notarization requires (scripts/package-mac.sh). The app itself needs none.
  - allow-jit, allow-unsigned-executable-memory: Node (V8) and Python's
    ctypes/cffi generate code at runtime.
  - disable-library-validation: the PyInstaller programs (the CLI and the
    hub) load libraries that weren't signed with this team's certificate:
    the CLI unpacks its own at startup.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
